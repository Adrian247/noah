APP_NAME=Phoenix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8888

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

PHOENIX_DEMO_PASSWORD=phoenix.2026$
PHOENIX_DEMO_ROOT_PASSWORD=pyro.2026$
PHOENIX_PLATFORM_ADMIN_EMAILS=admin@pyro-systems.com

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=phoenix
DB_USERNAME=phoenix
DB_PASSWORD=phoenix

SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@pyro-systems.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=phoenix
AWS_SECRET_ACCESS_KEY=phoenixsecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=phoenix
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
